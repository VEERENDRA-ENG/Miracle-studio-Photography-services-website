# ============================================================
# MIRACLE STUDIO PHOTOGRAPHY - BACKEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file and rename it to .env
# Fill in your actual values below
# NEVER commit the .env file to Git
# ============================================================

# Server port (default: 5000)
PORT=5000

# Your Supabase project URL (found in Supabase Dashboard > Settings > API)
SUPABASE_URL=

# Your Supabase SERVICE ROLE key (found in Supabase Dashboard > Settings > API)
# WARNING: This is a secret key. NEVER share it or put it in the React frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Your React frontend URL (used for CORS)
FRONTEND_URL=http://localhost:5173

# AI API key (for future chatbot - leave empty for now)
AI_API_KEY=

# Node environment: development or production
NODE_ENV=development
